{
  "name": "docswatcher-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "bundle": "node scripts/bundle-knowledge.mjs",
    "dev": "npm run bundle && nuxt dev",
    "build": "npm run bundle && nuxt build",
    "generate": "npm run bundle && nuxt generate && node scripts/relativize.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "parity": "npm run bundle && tsx scripts/parity.mjs",
    "check-api-cases": "npm run bundle && tsx scripts/regen-check-api-cases.mts",
    "test": "npm run bundle && vitest run",
    "e2e": "npm run generate && playwright test",
    "serve-export": "node scripts/serve-export.mjs"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "pako": "^3.0.2",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "vue": "^3.5.43",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pako": "^2.0.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "license": "Apache-2.0"
}
