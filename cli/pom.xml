<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.docswatcher</groupId>
    <artifactId>docswatcher</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>
  <artifactId>cli</artifactId>
  <name>DocsWatcher CLI</name>

  <properties>
    <!-- The tree-sitter binding ships a prebuilt library per platform in lib/ and loads the one
         matching the running OS and arch. The native image only needs this platform's. -->
    <!-- [.] rather than \. : on Windows the build passes arguments through a file that escapes
         backslashes, and the Windows DLLs were silently left out of the image. -->
    <native.treesitter.libs>lib/.*[.]so</native.treesitter.libs>
    <!-- Lets a local build link against a libz.so placed in native-link/ (gitignored). -->
    <native.linker.libpath>-L${project.basedir}/native-link</native.linker.libpath>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.docswatcher</groupId>
      <artifactId>engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>docswatcher-cli</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>${picocli.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Aproject=dev.docswatcher/cli</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.docswatcher.cli.DocsWatcher</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>macos</id>
      <activation><os><family>mac</family></os></activation>
      <properties>
        <native.treesitter.libs>lib/.*-macos-.*[.]dylib</native.treesitter.libs>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties>
        <native.treesitter.libs>lib/.*-windows-.*[.]dll</native.treesitter.libs>
        <!-- MSVC's linker spells -L as /LIBPATH: -->
        <native.linker.libpath>/LIBPATH:${project.basedir}/native-link</native.linker.libpath>
      </properties>
    </profile>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals><goal>compile-no-fork</goal></goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>docswatcher</imageName>
              <metadataRepository>
                <enabled>false</enabled>
              </metadataRepository>
              <mainClass>dev.docswatcher.cli.DocsWatcher</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:IncludeResources=docswatcher-knowledge/.*</buildArg>
                <buildArg>-H:IncludeResources=${native.treesitter.libs}</buildArg>
                <buildArg>-H:NativeLinkerOption=${native.linker.libpath}</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
