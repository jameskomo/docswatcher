#!/usr/bin/env bash
# Two-engine parity: the TypeScript engine in web/ must produce every fixture's expected-inventory.json byte for byte.
# The Java side is covered by engine/src/test/.../FixtureTest. This script runs the web side.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
root="$(cd "$here/.." && pwd)"
if [ -f "$root/web/scripts/parity.mjs" ]; then
  # parity.mjs imports the TypeScript engine, so it runs through the web package's tsx loader.
  cd "$root/web" && exec npm run --silent parity -- "$here" "$@"
fi
echo "web/scripts/parity.mjs not present yet; the web engine has no parity script. Java parity runs in the engine tests." >&2
exit 0
