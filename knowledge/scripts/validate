#!/usr/bin/env bash
# Validates the knowledge base. Run from the repo root or from knowledge/.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
root="$(cd "$here/.." && pwd)"
if [ -x "$root/cli/target/docwatcher" ]; then
  exec "$root/cli/target/docwatcher" validate "$here" "$@"
fi
jar="$root/cli/target/docwatcher-cli.jar"
if [ ! -f "$jar" ]; then
  echo "Building the CLI first (./mvnw -pl cli -am -DskipTests package)..." >&2
  (cd "$root" && source build-env.sh 2>/dev/null || true; ./mvnw -q -pl cli -am -DskipTests package)
fi
exec java --enable-native-access=ALL-UNNAMED -jar "$jar" validate "$here" "$@"
